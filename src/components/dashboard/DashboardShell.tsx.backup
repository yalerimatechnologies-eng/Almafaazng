function Icon({
  name,
  size = 20,
}: {
  name: IconName;
  size?: number;
}) {
  const common = {
    width: size,
    height: size,
    viewBox: "0 0 24 24",
    fill: "none",
    stroke: "currentColor",
    strokeWidth: 1.8,
    strokeLinecap: "round" as const,
    strokeLinejoin: "round" as const,
    "aria-hidden": true,
  };

  switch (name) {
    case "grid":
      return (
        <svg {...common}>
          <rect x="4" y="4" width="6" height="6" rx="1" />
          <rect x="14" y="4" width="6" height="6" rx="1" />
          <rect x="4" y="14" width="6" height="6" rx="1" />
          <rect x="14" y="14" width="6" height="6" rx="1" />
        </svg>
      );

    case "activity":
      return (
        <svg {...common}>
          <path d="M3 12h4l2.2-6 4.1 12 2.3-6H21" />
        </svg>
      );

    case "users":
      return (
        <svg {...common}>
          <circle cx="9" cy="8" r="3" />
          <path d="M3.5 20c.6-3.6 2.4-5.5 5.5-5.5s4.9 1.9 5.5 5.5" />
          <path d="M16 5.5a3 3 0 0 1 0 5.7" />
          <path d="M17 14.5c2 .6 3.3 2.3 3.7 5" />
        </svg>
      );

    case "shield":
      return (
        <svg {...common}>
          <path d="M12 3 20 6v5.5c0 4.7-3.1 7.8-8 9.5-4.9-1.7-8-4.8-8-9.5V6l8-3Z" />
          <path d="m8.7 12 2.1 2.1 4.6-4.6" />
        </svg>
      );

    case "book":
      return (
        <svg {...common}>
          <path d="M5 4.5h10a4 4 0 0 1 4 4V20H9a4 4 0 0 0-4 0V4.5Z" />
          <path d="M9 20V8.5a4 4 0 0 1 4-4" />
        </svg>
      );

    case "briefcase":
      return (
        <svg {...common}>
          <rect x="3" y="7" width="18" height="13" rx="2" />
          <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
          <path d="M3 12h18" />
        </svg>
      );

    case "monitor":
      return (
        <svg {...common}>
          <rect x="3" y="4" width="18" height="13" rx="2" />
          <path d="M8 21h8M12 17v4" />
        </svg>
      );

    case "clipboard":
      return (
        <svg {...common}>
          <rect x="5" y="4" width="14" height="17" rx="2" />
          <path d="M9 4V3h6v1M9 9h6M9 13h6M9 17h4" />
        </svg>
      );

    case "exam":
      return (
        <svg {...common}>
          <rect x="4" y="3" width="16" height="18" rx="2" />
          <path d="M8 8h8M8 12h8M8 16h5" />
          <path d="m15.5 16 1.2 1.2 2.3-2.6" />
        </svg>
      );

    case "chart":
      return (
        <svg {...common}>
          <path d="M4 19V5" />
          <path d="M4 19h16" />
          <path d="m7 15 3-4 3 2 5-7" />
        </svg>
      );

    case "wallet":
      return (
        <svg {...common}>
          <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H19v16H6.5A2.5 2.5 0 0 1 4 17.5v-11Z" />
          <path d="M4 7h15" />
          <path d="M15 12h4v4h-4a2 2 0 0 1 0-4Z" />
        </svg>
      );

    case "door":
      return (
        <svg {...common}>
          <path d="M6 21V4.5A1.5 1.5 0 0 1 7.5 3H18v18" />
          <path d="M6 21h14" />
          <path d="M14 12h.01" />
        </svg>
      );

    case "message":
      return (
        <svg {...common}>
          <path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8.7 8.7 0 0 1-3.5-.7L4 20l1.5-3.8A7.2 7.2 0 0 1 4 11.5 7.5 7.5 0 0 1 12 4a7.5 7.5 0 0 1 8 7.5Z" />
        </svg>
      );

    case "settings":
      return (
        <svg {...common}>
          <path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z" />
          <path d="m19 13 .8 1.5-1.8 1.8-1.5-.8-1.4.8-.4 1.6h-2.6l-.4-1.6-1.4-.8-1.5.8-1.8-1.8L8 13l-.8-1.4.8-1.5-1-1.4L8.8 7l1.5.8 1.4-.8.4-1.6h2.6l.4 1.6 1.4.8 1.5-.8 1.8 1.7-1 1.5.8 1.4Z" />
        </svg>
      );

    case "search":
      return (
        <svg {...common}>
          <circle cx="10.8" cy="10.8" r="6.5" />
          <path d="m16 16 4.5 4.5" />
        </svg>
      );

    case "bell":
      return (
        <svg {...common}>
          <path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9Z" />
          <path d="M10 21h4" />
        </svg>
      );

    case "sun":
      return (
        <svg {...common}>
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      );

    case "moon":
      return (
        <svg {...common}>
          <path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z" />
        </svg>
      );

    case "menu":
      return (
        <svg {...common}>
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      );

    case "refresh":
      return (
        <svg {...common}>
          <path d="M20 11a8 8 0 0 0-14.5-4L4 9" />
          <path d="M4 5v4h4" />
          <path d="M4 13a8 8 0 0 0 14.5 4L20 15" />
          <path d="M20 19v-4h-4" />
        </svg>
      );

    case "chevron":
      return (
        <svg {...common}>
          <path d="m9 6 6 6-6 6" />
        </svg>
      );

    case "logout":
      return (
        <svg {...common}>
          <path d="M10 5H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4" />
          <path d="m14 8 4 4-4 4" />
          <path d="M18 12H9" />
        </svg>
      );

    case "user":
      return (
        <svg {...common}>
          <circle cx="12" cy="8" r="3.5" />
          <path d="M5 21c.6-4.2 3-6.3 7-6.3s6.4 2.1 7 6.3" />
        </svg>
      );

    case "calendar":
      return (
        <svg {...common}>
          <rect x="4" y="5" width="16" height="15" rx="2" />
          <path d="M8 3v4M16 3v4M4 9h16" />
        </svg>
      );

    default:
      return null;
  }
}

function NavLink({
  item,
  active,
  collapsed,
  onNavigate,
}: {
  item: NavItem;
  active: boolean;
  collapsed: boolean;
  onNavigate: () => void;
}) {
  return (
    <Link
      href={item.href}
      onClick={onNavigate}
      className={`nav-link ${active ? "nav-link-active" : ""}`}
      title={collapsed ? item.label : undefined}
    >
      <span className="nav-link-icon">
        <Icon name={item.icon} size={20} />
      </span>

      {!collapsed && <span className="nav-link-label">{item.label}</span>}
    </Link>
  );
}

function ExpandableNav({
  group,
  open,
  collapsed,
  active,
  onToggle,
  onNavigate,
}: {
  group: NavGroup;
  open: boolean;
  collapsed: boolean;
  active: boolean;
  onToggle: () => void;
  onNavigate: () => void;
}) {
  return (
    <div className={`nav-expandable ${open ? "is-open" : ""}`}>
      <button
        type="button"
        className={`nav-expand-trigger ${active ? "has-active-child" : ""} ${
          open ? "is-open" : ""
        }`}
        aria-expanded={open}
        title={collapsed ? group.label : undefined}
        onClick={onToggle}
      >
        <span className="nav-link-icon">
          <Icon name={group.icon} size={21} />
        </span>

        {!collapsed && (
          <>
            <span className="nav-link-label">{group.label}</span>

            {group.badge && (
              <span className="nav-badge">{group.badge}</span>
            )}

            <span
              className={`nav-expand-arrow ${open ? "is-open" : ""}`}
              aria-hidden="true"
            >
              <Icon name="chevron" size={17} />
            </span>
          </>
        )}
      </button>

      {!collapsed && (
        <div className={`nav-submenu ${open ? "is-open" : ""}`}>
          <div className="nav-submenu-inner">
            {group.items.map((item) => (
              <Link
                key={item.href}
                href={item.href}
                onClick={onNavigate}
                className={`nav-submenu-item ${
                  active && item.href
                    ? "nav-submenu-item-active"
                    : ""
                }`}
              >
                <span className="nav-submenu-icon">
                  <Icon name={item.icon} size={17} />
                </span>

                <span className="nav-submenu-label">{item.label}</span>

                {active && (
                  <span className="nav-selected-dot" aria-hidden="true" />
                )}
              </Link>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}

export default function DashboardShell({
  children,
}: DashboardShellProps) {
  const pathname = usePathname();

  const [collapsed, setCollapsed] = useState(false);
  const [mobileOpen, setMobileOpen] = useState(false);
  const [dark, setDark] = useState(false);
  const [search, setSearch] = useState("");
  const [openGroup, setOpenGroup] = useState<string | null>(null);

  const activeGroup = useMemo(() => {
    const match = navGroups.find((group) =>
      pathname.startsWith(group.prefix)
    );

    return match?.key ?? null;
  }, [pathname]);

  useEffect(() => {
    if (activeGroup) {
      setOpenGroup(activeGroup);
    }
  }, [activeGroup]);

  useEffect(() => {
    setMobileOpen(false);
  }, [pathname]);

  useEffect(() => {
    document.body.classList.toggle(
      "dashboard-drawer-open",
      mobileOpen
    );

    return () => {
      document.body.classList.remove("dashboard-drawer-open");
    };
  }, [mobileOpen]);

  useEffect(() => {
    document.documentElement.classList.toggle("dashboard-dark", dark);
  }, [dark]);

  const isActive = (href: string) => {
    if (href === "/super-admin") {
      return pathname === "/super-admin";
    }

    return pathname === href || pathname.startsWith(`${href}/`);
  };

  const handleGroupToggle = (key: string) => {
    if (collapsed) {
      setCollapsed(false);
      setOpenGroup(key);
      return;
    }

    setOpenGroup((current) => (current === key ? null : key));
  };

  const handleMobileOpen = () => {
    setCollapsed(false);
    setMobileOpen(true);
  };

  const handleNavigate = () => {
    if (window.innerWidth <= 700) {
      setMobileOpen(false);
    }
  };

  const handleRefresh = () => {
    window.location.reload();
  };

  return (
    <div className={`dashboard-shell ${dark ? "dashboard-theme-dark" : ""}`}>
      <aside
        className={`dashboard-sidebar ${
          collapsed ? "sidebar-collapsed" : ""
        } ${mobileOpen ? "sidebar-mobile-open" : ""}`}
      >
        <div className="sidebar-header">
          <Link
            href="/super-admin"
            className="dashboard-brand"
            onClick={handleNavigate}
          >
            <span className="dashboard-brand-mark">A</span>

            {!collapsed && (
              <span className="dashboard-brand-copy">
                <strong>ALMAFAAZ</strong>
                <small>ACADEMY</small>
              </span>
            )}
          </Link>

          <button
            type="button"
            className="sidebar-close-mobile"
            aria-label="Close navigation"
            onClick={() => setMobileOpen(false)}
          >
            ×
          </button>
        </div>

        <div className="sidebar-scroll">
          <section className="sidebar-section">
            {!collapsed && (
              <div className="sidebar-section-label">WORKSPACE</div>
            )}

            <nav className="dashboard-nav">
              {workspaceLinks.map((item) => (
                <NavLink
                  key={item.href}
                  item={item}
                  active={isActive(item.href)}
                  collapsed={collapsed}
                  onNavigate={handleNavigate}
                />
              ))}
            </nav>
          </section>

          <section className="sidebar-section">
            {!collapsed && (
              <div className="sidebar-section-label">INSTITUTION</div>
            )}

            <nav className="dashboard-nav">
              {navGroups.map((group) => (
                <ExpandableNav
                  key={group.key}
                  group={group}
                  open={openGroup === group.key}
                  collapsed={collapsed}
                  active={activeGroup === group.key}
                  onToggle={() => handleGroupToggle(group.key)}
                  onNavigate={handleNavigate}
                />
              ))}
            </nav>
          </section>

          <section className="sidebar-section sidebar-system-section">
            {!collapsed && (
              <div className="sidebar-section-label">SYSTEM</div>
            )}

            <nav className="dashboard-nav">
              {systemLinks.map((item) => (
                <NavLink
                  key={item.href}
                  item={item}
                  active={isActive(item.href)}
                  collapsed={collapsed}
                  onNavigate={handleNavigate}
                />
              ))}
            </nav>
          </section>
        </div>

        <div className="sidebar-footer">
          {!collapsed && (
            <div className="sidebar-help">
              <div className="sidebar-help-icon">?</div>

              <div className="sidebar-help-copy">
                <strong>Need assistance?</strong>
                <span>Academy support centre</span>
              </div>

              <Link
                href="/super-admin/messages"
                onClick={handleNavigate}
                className="sidebar-help-link"
              >
                Support
                <Icon name="chevron" size={15} />
              </Link>
            </div>
          )}

          <button
            type="button"
            className="sidebar-collapse"
            onClick={() => setCollapsed((value) => !value)}
            aria-label={collapsed ? "Expand menu" : "Collapse menu"}
          >
            {!collapsed && (
              <span className="sidebar-collapse-label">
                Collapse menu
              </span>
            )}

            <span className="sidebar-collapse-icon">
              <Icon name="chevron" size={17} />
            </span>
          </button>
        </div>
      </aside>

      {mobileOpen && (
        <button
          type="button"
          className="sidebar-backdrop"
          aria-label="Close navigation"
          onClick={() => setMobileOpen(false)}
        />
      )}

      <div className="dashboard-main">
        <header className="dashboard-topbar">
          <div className="topbar-left">
            <button
              type="button"
              className="mobile-menu-button"
              aria-label="Open navigation"
              onClick={handleMobileOpen}
            >
              <Icon name="menu" size={22} />
            </button>

            <div className="dashboard-breadcrumb">
              <span>Super Administrator</span>
              <Icon name="chevron" size={15} />
              <strong>
                {pathname === "/super-admin"
                  ? "Overview"
                  : "Command Centre"}
              </strong>
            </div>
          </div>

          <div className="topbar-center">
            <label className="dashboard-search">
              <Icon name="search" size={19} />

              <input
                type="search"
                value={search}
                onChange={(event) => setSearch(event.target.value)}
                placeholder="Search..."
                aria-label="Search academy"
              />
            </label>
          </div>

          <div className="topbar-right">
            <div className="dashboard-clock">
              <LiveClock />
            </div>

            <button
              type="button"
              className="topbar-icon-button"
              onClick={() => setDark((value) => !value)}
              aria-label={
                dark ? "Switch to light theme" : "Switch to dark theme"
              }
            >
              <Icon name={dark ? "sun" : "moon"} size={19} />
            </button>

            <button
              type="button"
              className="topbar-icon-button"
              aria-label="Notifications"
            >
              <Icon name="bell" size={19} />
              <span className="notification-dot" />
            </button>

            <button
              type="button"
              className="topbar-icon-button"
              onClick={handleRefresh}
              aria-label="Refresh dashboard"
            >
              <Icon name="refresh" size={19} />
            </button>

            <div className="topbar-profile">
              <div className="topbar-profile-avatar">
                SA
              </div>

              <div className="topbar-profile-copy">
                <strong>Super Administrator</strong>
                <span>Root access</span>
              </div>
            </div>
          </div>
        </header>

        <main className="dashboard-content">{children}</main>
      </div>
    </div>
  );
}
