"use client";

import React, { useEffect, useMemo, useState } from "react";
import Link from "next/link";
import { usePathname } from "next/navigation";
import LiveClock from "./LiveClock";

type IconName =
  | "grid"
  | "activity"
  | "users"
  | "shield"
  | "book"
  | "briefcase"
  | "monitor"
  | "clipboard"
  | "exam"
  | "chart"
  | "wallet"
  | "door"
  | "message"
  | "settings"
  | "search"
  | "bell"
  | "sun"
  | "moon"
  | "menu"
  | "refresh"
  | "chevron"
  | "logout"
  | "user"
  | "calendar";

type NavItem = {
  label: string;
  href: string;
  icon: IconName;
};

type NavGroup = {
  key: string;
  label: string;
  icon: IconName;
  badge?: string;
  prefix: string;
  items: NavItem[];
};

type DashboardShellProps = {
  children: React.ReactNode;
};

