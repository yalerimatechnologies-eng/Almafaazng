function NavLink({
  item,
  active,
  collapsed,
  onNavigate,
}: {
  item: NavItem;
  active: boolean;
  collapsed: boolean;
  onNavigate: () => void;
}) {
  return (
    <Link
      href={item.href}
      onClick={onNavigate}
      title={collapsed ? item.label : undefined}
      className={`dashboard-nav-link ${active ? "is-active" : ""}`}
    >
      <span className="dashboard-nav-icon"><Icon name={item.icon} size={18} /></span>
      {!collapsed && <span>{item.label}</span>}
    </Link>
  );
}

function ExpandableNav({
  group,
  open,
  activeItem,
  collapsed,
  onToggle,
  onNavigate,
}: {
  group: NavGroup;
  open: boolean;
  activeItem: (href: string) => boolean;
  collapsed: boolean;
  onToggle: () => void;
  onNavigate: () => void;
}) {
  const active = group.items.some((item) => activeItem(item.href));

  if (collapsed) {
    return (
      <div className={`dashboard-nav-group collapsed-group ${active ? "has-active" : ""}`}>
        <button
          type="button"
          className={`dashboard-nav-group-button ${active ? "is-active" : ""}`}
          onClick={onToggle}
          title={group.label}
        >
          <span className="dashboard-nav-icon"><Icon name={group.icon} size={18} /></span>
        </button>
      </div>
    );
  }

  return (
    <div className={`dashboard-nav-group ${open ? "is-open" : ""}`}>
      <button
        type="button"
        className={`dashboard-nav-group-button ${active ? "is-active" : ""}`}
        onClick={onToggle}
        aria-expanded={open}
      >
        <span className="dashboard-nav-icon"><Icon name={group.icon} size={18} /></span>
        <span className="dashboard-nav-group-label">{group.label}</span>
        {group.badge && <span className="dashboard-nav-badge">{group.badge}</span>}
        <span className={`dashboard-nav-chevron ${open ? "rotated" : ""}`}>
          <Icon name="chevron" size={15} />
        </span>
      </button>

      <div className={`dashboard-nav-children ${open ? "is-open" : ""}`}>
        {group.items.map((item) => (
          <NavLink
            key={item.href}
            item={item}
            active={activeItem(item.href)}
            collapsed={false}
            onNavigate={onNavigate}
          />
        ))}
      </div>
    </div>
  );
}

export default function DashboardShell({
  children,
}: {
  children: React.ReactNode;
}) {
  const pathname = usePathname();

  const [collapsed, setCollapsed] = useState(false);
  const [mobileOpen, setMobileOpen] = useState(false);
  const [dark, setDark] = useState(false);
  const [search, setSearch] = useState("");
  const [openGroup, setOpenGroup] = useState<string | null>(null);
  const [profileOpen, setProfileOpen] = useState(false);
  const [nigeriaTime, setNigeriaTime] = useState("");
  const [nigeriaDate, setNigeriaDate] = useState("");
  const [signingOut, setSigningOut] = useState(false);
  const profileRef = useRef<HTMLDivElement>(null);

  const activeItem = (href: string) =>
    href === "/super-admin"
      ? pathname === href
      : pathname === href || pathname.startsWith(`${href}/`);

  const activeGroup = useMemo(
    () => groups.find((group) => pathname.startsWith(group.prefix))?.label ?? null,
    [pathname]
  );

  useEffect(() => {
    if (activeGroup) setOpenGroup(activeGroup);
  }, [activeGroup]);

  useEffect(() => {
    setMobileOpen(false);
    setProfileOpen(false);
  }, [pathname]);

  useEffect(() => {
    document.documentElement.classList.toggle("dashboard-theme-dark", dark);
    return () => document.documentElement.classList.remove("dashboard-theme-dark");
  }, [dark]);

  useEffect(() => {
    const updateNigeriaClock = () => {
      const now = new Date();

      setNigeriaTime(
        new Intl.DateTimeFormat("en-NG", {
          timeZone: "Africa/Lagos",
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit",
          hour12: true,
        }).format(now)
      );

      setNigeriaDate(
        new Intl.DateTimeFormat("en-NG", {
          timeZone: "Africa/Lagos",
          weekday: "long",
          day: "2-digit",
          month: "long",
          year: "numeric",
        }).format(now)
      );
    };

    updateNigeriaClock();
    const timer = window.setInterval(updateNigeriaClock, 1000);
    return () => window.clearInterval(timer);
  }, []);

  useEffect(() => {
    const handler = (event: MouseEvent) => {
      if (profileRef.current && !profileRef.current.contains(event.target as Node)) {
        setProfileOpen(false);
      }
    };

    document.addEventListener("mousedown", handler);
    return () => document.removeEventListener("mousedown", handler);
  }, []);

  useEffect(() => {
    const handler = (event: KeyboardEvent) => {
      if (event.key === "Escape") {
        setProfileOpen(false);
        setMobileOpen(false);
      }
    };

    document.addEventListener("keydown", handler);
    return () => document.removeEventListener("keydown", handler);
  }, []);

  useEffect(() => {
    document.body.classList.toggle("dashboard-drawer-open", mobileOpen);
    return () => document.body.classList.remove("dashboard-drawer-open");
  }, [mobileOpen]);

  const filteredSearch = useMemo(() => {
    const term = search.trim().toLowerCase();
    if (!term) return [];

    const all = [
      ...workspace,
      ...groups.flatMap((group) => group.items),
      ...system,
    ];

    return all.filter((item) => item.label.toLowerCase().includes(term)).slice(0, 7);
  }, [search]);

  const handleRefresh = () => {
    window.location.reload();
  };

  const handleSignOut = async () => {
    if (signingOut) return;

    setSigningOut(true);

    try {
      await supabase.auth.signOut();
      window.location.href = "/";
    } catch {
      setSigningOut(false);
    }
  };

  const closeNavigation = () => setMobileOpen(false);

  return (
    <div className={`dashboard-shell ${collapsed ? "sidebar-collapsed" : ""} ${dark ? "dashboard-is-dark" : ""}`}>
      <aside className={`dashboard-sidebar ${mobileOpen ? "mobile-open" : ""}`}>
        <div className="dashboard-brand">
          <Link href="/super-admin" className="dashboard-brand-link" onClick={closeNavigation}>
            <span className="dashboard-brand-mark">
              <img src="/almafaaz-logo.png" alt="ALMAFAAZ ACADEMY" />
            </span>

            {!collapsed && (
              <span className="dashboard-brand-copy">
                <strong>ALMAFAAZ</strong>
                <small>ACADEMY</small>
              </span>
            )}
          </Link>

          <button
            type="button"
            className="dashboard-sidebar-close-mobile"
            onClick={() => setMobileOpen(false)}
            aria-label="Close navigation"
          >
            ×
          </button>
        </div>

        <div className="dashboard-sidebar-scroll">
          <div className="dashboard-nav-section">
            {!collapsed && <div className="dashboard-nav-section-title">Workspace</div>}

            {workspace.map((item) => (
              <NavLink
                key={item.href}
                item={item}
                active={activeItem(item.href)}
                collapsed={collapsed}
                onNavigate={closeNavigation}
              />
            ))}
          </div>

          <div className="dashboard-nav-section">
            {!collapsed && <div className="dashboard-nav-section-title">Management</div>}

            {groups.map((group) => (
              <ExpandableNav
                key={group.label}
                group={group}
                open={openGroup === group.label}
                activeItem={activeItem}
                collapsed={collapsed}
                onToggle={() =>
                  setOpenGroup((current) =>
                    current === group.label ? null : group.label
                  )
                }
                onNavigate={closeNavigation}
              />
            ))}
          </div>

          <div className="dashboard-nav-section">
            {!collapsed && <div className="dashboard-nav-section-title">System</div>}

            {system.map((item) => (
              <NavLink
                key={item.href}
                item={item}
                active={activeItem(item.href)}
                collapsed={collapsed}
                onNavigate={closeNavigation}
              />
            ))}
          </div>
        </div>

        <div className="dashboard-sidebar-footer">
          <div className="dashboard-sidebar-status">
            <span className="status-dot" />
            {!collapsed && <span>System operational</span>}
          </div>

          <button
            type="button"
            className="dashboard-collapse-button"
            onClick={() => setCollapsed((value) => !value)}
            title={collapsed ? "Expand sidebar" : "Collapse sidebar"}
          >
            <Icon name="chevron" size={17} />
            {!collapsed && <span>Collapse navigation</span>}
          </button>
        </div>
      </aside>

      {mobileOpen && (
        <button
          type="button"
          className="dashboard-mobile-overlay"
          aria-label="Close navigation"
          onClick={() => setMobileOpen(false)}
        />
      )}

      <div className="dashboard-main">
        <header className="dashboard-topbar">
          <div className="dashboard-topbar-left">
            <button
              type="button"
              className="dashboard-mobile-menu"
              onClick={() => setMobileOpen(true)}
              aria-label="Open navigation"
            >
              <Icon name="menu" size={23} />
            </button>

            <div className="dashboard-search-wrap">
              <Icon name="search" size={21} />
              <input
                value={search}
                onChange={(event) => setSearch(event.target.value)}
                placeholder="Search workspace..."
                aria-label="Search workspace"
              />

              {filteredSearch.length > 0 && (
                <div className="dashboard-search-results">
                  {filteredSearch.map((item) => (
                    <Link
                      key={item.href}
                      href={item.href}
                      onClick={() => setSearch("")}
                    >
                      <span><Icon name={item.icon} size={17} /></span>
                      <span>{item.label}</span>
                    </Link>
                  ))}
                </div>
              )}
            </div>
          </div>

          <div className="dashboard-topbar-actions">
            <LiveClock />

            <button
              type="button"
              className="dashboard-icon-button"
              onClick={() => setDark((value) => !value)}
              title={dark ? "Use light theme" : "Use dark theme"}
              aria-label={dark ? "Use light theme" : "Use dark theme"}
            >
              <Icon name={dark ? "sun" : "moon"} size={20} />
            </button>

            <button
              type="button"
              className="dashboard-icon-button notification-button"
              title="Notifications"
              aria-label="Notifications"
            >
              <Icon name="bell" size={20} />
              <span className="notification-dot" />
            </button>

            <button
              type="button"
              className="dashboard-icon-button"
              onClick={handleRefresh}
              title="Refresh workspace"
              aria-label="Refresh workspace"
            >
              <Icon name="refresh" size={20} />
            </button>

            <div className="topbar-profile-wrap" ref={profileRef}>
              <button
                type="button"
                className={`topbar-profile ${profileOpen ? "is-open" : ""}`}
                onClick={() => setProfileOpen((value) => !value)}
                aria-expanded={profileOpen}
              >
                <span className="topbar-profile-avatar">SA</span>

                <span className="topbar-profile-copy">
                  <strong>Super Administrator</strong>
                  <small>Full academy control</small>
                </span>

                <span className="topbar-profile-chevron">
                  <Icon name="chevron" size={15} />
                </span>
              </button>

              {profileOpen && (
                <div className="profile-control-panel">
                  <div className="profile-panel-header">
                    <span className="profile-panel-avatar">SA</span>
                    <div>
                      <strong>Super Administrator</strong>
                      <small>Root administration</small>
                    </div>
                  </div>

                  <div className="profile-live-time">
                    <span>LOCAL ACADEMY TIME</span>
                    <strong>{nigeriaTime}</strong>
                    <small>{nigeriaDate} · WAT</small>
                  </div>

                  <Link href="/super-admin/activity" onClick={() => setProfileOpen(false)}>
                    <Icon name="chart" size={17} />
                    Activity Centre
                  </Link>

                  <Link href="/super-admin/settings" onClick={() => setProfileOpen(false)}>
                    <Icon name="settings" size={17} />
                    Settings
                  </Link>

                  <button type="button" onClick={() => setDark((value) => !value)}>
                    <Icon name={dark ? "sun" : "moon"} size={17} />
                    {dark ? "Light appearance" : "Dark appearance"}
                  </button>

                  <button type="button" onClick={handleRefresh}>
                    <Icon name="refresh" size={17} />
                    Refresh workspace
                  </button>

                  <div className="profile-panel-divider" />

                  <button
                    type="button"
                    className="profile-signout"
                    onClick={handleSignOut}
                    disabled={signingOut}
                  >
                    <Icon name="logout" size={17} />
                    {signingOut ? "Signing out..." : "Sign out"}
                  </button>
                </div>
              )}
            </div>
          </div>
        </header>

        <main className="dashboard-content">
          {children}
        </main>
      </div>
    </div>
  );
}
